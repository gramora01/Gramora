
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION CHECK
    function signedIn() {
      return request.auth != null;
    }

    // ACCOUNT OWNER CHECK
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // USER PROFILES
    match /userProfiles/{uid} {

      // Signed-in users can view public profiles.
      allow read: if signedIn();

      // Only the account owner can create their profile.
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'email',
          'bio',
          'photoURL',
          'followersCount',
          'followingCount',
          'createdAt',
          'updatedAt'
        ]);

      // Only the owner can update allowed profile fields.
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'username',
            'bio',
            'photoURL',
            'updatedAt'
          ]);

      // Profile deletion is blocked from the client.
      allow delete: if false;
    }

    // USERNAME RESERVATIONS
    match /usernames/{username} {

      allow read: if signedIn();

      // A user can reserve a username for their own UID.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt'
        ]);

      // Only the owner can release their username.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      // Username reservation cannot be overwritten.
      allow update: if false;
    }

    // FOLLOW SYSTEM
    match /follows/{followId} {

      allow read: if signedIn();

      // Users can create only their own follow relationship.
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + '_'
          + request.resource.data.followingUid
        && request.resource.data.keys().hasOnly([
          'followerUid',
          'followingUid',
          'createdAt'
        ]);

      // Only the follower can remove their relationship.
      allow delete: if signedIn()
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    // POSTS
    match /posts/{postId} {

      // Signed-in members can view posts.
      allow read: if signedIn();

      // A user can create only their own post.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'text',
          'background',
          'createdAt'
        ])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Only the post owner can edit post text.
      // Ownership cannot be transferred.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['text','background'])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Only the post owner can delete their post.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // POST LIKES: one like per user per post.
    match /postLikes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postUid is string
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','postUid','uid','displayName','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // POST COMMENTS: signed-in members can read; authors can remove their own comments.
    match /postComments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly(['postId','postUid','uid','displayName','text','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // REPOSTS
    match /reposts/{repostId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.originalPostId is string
        && request.resource.data.originalUid is string
        && request.resource.data.originalUid != request.auth.uid
        && repostId == request.resource.data.originalPostId + '_' + request.auth.uid
        && request.resource.data.originalText is string
        && request.resource.data.originalText.size() <= 2000
        && request.resource.data.keys().hasOnly(['uid','displayName','originalPostId','originalUid','originalDisplayName','originalUsername','originalPhotoURL','originalText','originalBackground','originalCreatedAt','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // TEXT STORIES (expire in 24 hours; clients hide expired stories)
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','displayName','text','songTitle','songArtist','songUrl','previewUrl','background','createdAt','expiresAt'
        ])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.songTitle is string
        && request.resource.data.songArtist is string
        && request.resource.data.songUrl is string
        && request.resource.data.songUrl.size() <= 500
        && request.resource.data.previewUrl is string
        && request.resource.data.previewUrl.size() <= 1000
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','background'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200;
    }

    // STORY HIGHLIGHTS: owner creates and manages saved story collections.
    match /storyHighlights/{highlightId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 24
        && request.resource.data.stories is list
        && request.resource.data.stories.size() > 0
        && request.resource.data.stories.size() <= 20
        && request.resource.data.keys().hasOnly(['uid','title','coverText','stories','createdAt']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','coverText','stories'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 24
        && request.resource.data.stories is list
        && request.resource.data.stories.size() > 0
        && request.resource.data.stories.size() <= 20;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // STORY VIEWS: viewers can create their own view; only story owner can list viewers.
    match /storyViews/{viewId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyUid is string
        && request.resource.data.storyUid != request.auth.uid
        && request.resource.data.storyId is string
        && viewId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['storyId','storyUid','uid','displayName','createdAt']);
      // A viewer can check their deterministic document ID even before it exists.
      // The story owner can read/list only views belonging to their own stories.
      allow get: if signedIn()
        && (viewId.matches('.*_' + request.auth.uid)
          || resource.data.storyUid == request.auth.uid);
      allow list: if signedIn()
        && resource.data.storyUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // STORY LIKES
    match /storyLikes/{likeId} {
      // A viewer can read their own like; only the story owner can list likes.
      allow get: if signedIn()
        && (likeId.matches('.*_' + request.auth.uid)
          || resource.data.storyUid == request.auth.uid);
      allow list: if signedIn()
        && resource.data.storyUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyId is string
        && request.resource.data.storyUid is string
        && likeId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['storyId','storyUid','uid','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // STORY REPLIES
    match /storyReplies/{replyId} {
      // Replies are private to the owner of the story they belong to.
      allow read: if signedIn()
        && resource.data.storyOwnerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyId is string
        && request.resource.data.storyOwnerUid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.keys().hasOnly(['storyId','storyOwnerUid','uid','displayName','text','createdAt']);
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.storyOwnerUid == request.auth.uid);
      allow update: if false;
    }

    // SAVED POSTS: each user manages only their own saved-post references.
    match /savedPosts/{savedId} {
      // Allow checking the deterministic own-save document, even before it exists.
      allow get: if signedIn()
        && (savedId.matches('.*_' + request.auth.uid)
          || resource.data.uid == request.auth.uid);

      // Queries must be constrained to the signed-in user's own saved posts.
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && savedId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','uid','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // IN-APP NOTIFICATIONS: recipients can read their own; senders create their own activity.
    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 180
        && request.resource.data.type in ['post_like','post_comment','follow','story_like','story_reply']
        && request.resource.data.postId is string
        && request.resource.data.storyId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['toUid','fromUid','fromName','type','message','postId','storyId','createdAt','read']);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }


    // ONLINE PRESENCE: signed-in users can see status; each user controls only their own status.
    match /userPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.keys().hasOnly(['uid','online','lastSeen']);
      allow delete: if false;
    }

    // DIRECT MESSAGES: only the two conversation participants can access a chat.
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participantUids;
      }

      allow get, list: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastMessage == ''
        && request.resource.data.keys().hasOnly([
          'participantUids','createdBy','createdAt','updatedAt',
          'lastMessage','lastMessageAt','lastMessageSenderUid'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Participants cannot be changed after a conversation is created.
      // Only a participant sending a message may update the preview fields.
      allow update: if isParticipant()
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage','lastMessageAt','lastMessageSenderUid','updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in parentConversation().data.participantUids;
        }

        allow get, list: if isChatParticipant();

        allow create: if isChatParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in ['text','sticker','gif']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            'senderUid','text','type','createdAt','replyToId','replyToText','mediaUrl'
          ])
          && (!('replyToId' in request.resource.data) || request.resource.data.replyToId is string)
          && (!('replyToText' in request.resource.data) || request.resource.data.replyToText is string)
          && (!('mediaUrl' in request.resource.data)
            || (request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() <= 2000
              && request.resource.data.mediaUrl.matches('https://.*')));

        // A sender can edit only their own text message.
        allow update: if isChatParticipant()
          && resource.data.senderUid == request.auth.uid
          && resource.data.type == 'text'
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.type == resource.data.type
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt is timestamp;
        allow delete: if false;
      }

      // Typing state is private to chat participants; each user controls only their own doc.
      match /typing/{uid} {
        function canUseTyping() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        }
        allow read: if canUseTyping();
        allow create, update: if canUseTyping()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.typing == true
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly(['uid','typing','updatedAt']);
        allow delete: if canUseTyping() && uid == request.auth.uid;
      }
    }

    // DENY ALL OTHER COLLECTIONS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
