
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION CHECK
    function signedIn() {
      return request.auth != null;
    }

    // ACCOUNT OWNER CHECK
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A relationship is blocked if either member has blocked the other.
    function noBlockWith(otherUid) {
      return signedIn()
        && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid + '_' + otherUid))
        && !exists(/databases/$(database)/documents/userBlocks/$(otherUid + '_' + request.auth.uid));
    }

    // Private content is readable only by its owner, public viewers, or approved followers.
    function canViewUserContent(ownerUid) {
      return signedIn()
        && noBlockWith(ownerUid)
        && (ownerUid == request.auth.uid
          || !exists(/databases/$(database)/documents/userProfiles/$(ownerUid))
          || get(/databases/$(database)/documents/userProfiles/$(ownerUid)).data.get('isPrivate', false) != true
          || exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + ownerUid)));
    }

    // USER PROFILES
    match /userProfiles/{uid} {

      // Signed-in users can view public profiles.
      allow read: if signedIn();

      // Only the account owner can create their profile.
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'email',
          'bio',
          'photoURL',
          'followersCount',
          'followingCount',
          'createdAt',
          'updatedAt'
        ]);

      // Only the owner can update allowed profile fields.
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'username',
            'bio',
            'photoURL',
            'updatedAt',
            'isPrivate'
          ]);

      // Profile deletion is blocked from the client.
      allow delete: if false;
    }

    // USER BLOCKS: only the blocker can list, create, or remove their block records.
    match /userBlocks/{blockId} {
      allow get: if signedIn()
        && (blockId.matches(request.auth.uid + '_.*')
          || blockId.matches('.*_' + request.auth.uid));
      allow list: if signedIn()
        && resource.data.blockerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.blockedName is string
        && request.resource.data.blockedName.size() <= 60
        && request.resource.data.blockedUsername is string
        && request.resource.data.blockedUsername.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['blockerUid','blockedUid','blockedName','blockedUsername','createdAt']);
      allow delete: if signedIn()
        && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // USERNAME RESERVATIONS
    match /usernames/{username} {

      allow read: if signedIn();

      // A user can reserve a username for their own UID.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt'
        ]);

      // Only the owner can release their username.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      // Username reservation cannot be overwritten.
      allow update: if false;
    }

    // FOLLOW SYSTEM
    match /follows/{followId} {

      allow read: if signedIn();

      // Users can create only their own follow relationship.
      allow create: if signedIn()
        && request.resource.data.followerUid is string
        && request.resource.data.followingUid is string
        && followId == request.resource.data.followerUid + '_'
          + request.resource.data.followingUid
        && request.resource.data.keys().hasOnly([
          'followerUid',
          'followingUid',
          'createdAt'
        ])
        && ((request.resource.data.followerUid == request.auth.uid
            && request.resource.data.followingUid != request.auth.uid
            && noBlockWith(request.resource.data.followingUid)
            && (!exists(/databases/$(database)/documents/userProfiles/$(request.resource.data.followingUid))
              || get(/databases/$(database)/documents/userProfiles/$(request.resource.data.followingUid)).data.get('isPrivate', false) != true))
          || (request.resource.data.followingUid == request.auth.uid
            && request.resource.data.followerUid != request.auth.uid
            && noBlockWith(request.resource.data.followerUid)
            && exists(/databases/$(database)/documents/followRequests/$(request.resource.data.followerUid + '_' + request.auth.uid))));

      // Only the follower can remove their relationship.
      allow delete: if signedIn()
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    // FOLLOW REQUESTS: requester and recipient can check; only recipient can list requests.
    match /followRequests/{requestId} {
      allow get: if signedIn()
        && (requestId.matches(request.auth.uid + '_.*') || requestId.matches('.*_' + request.auth.uid));
      allow list: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && get(/databases/$(database)/documents/userProfiles/$(request.resource.data.toUid)).data.get('isPrivate', false) == true
        && noBlockWith(request.resource.data.toUid)
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 60
        && request.resource.data.fromUsername is string
        && request.resource.data.fromUsername.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['fromUid','toUid','fromName','fromUsername','createdAt']);
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // POSTS
    match /posts/{postId} {

      // Only owner, public viewers, and approved followers can read posts.
      allow read: if canViewUserContent(resource.data.uid);

      // A user can create only their own post.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'text',
          'background',
          'createdAt'
        ])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Only the post owner can edit post text.
      // Ownership cannot be transferred.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['text','background'])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Only the post owner can delete their post.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // POST LIKES: one like per user per post.
    match /postLikes/{likeId} {
      // Allow users to check their own deterministic like document even when it does not exist yet.
      // Other likes remain readable only when the post owner’s content is visible to the viewer.
      allow read: if signedIn()
        && (likeId.matches('.*_' + request.auth.uid)
          || canViewUserContent(resource.data.postUid));
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postUid is string
        && canViewUserContent(request.resource.data.postUid)
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','postUid','uid','displayName','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // POST COMMENTS: signed-in members can read; authors can remove their own comments.
    match /postComments/{commentId} {
      allow read: if canViewUserContent(resource.data.postUid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postUid is string
        && canViewUserContent(request.resource.data.postUid)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly(['postId','postUid','uid','displayName','text','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // PRIVATE REPOST RECORDS: only the reposter and original post owner can read them.
    match /reposts/{repostId} {
      allow get: if signedIn()
        && (repostId.matches('.*_' + request.auth.uid)
          || resource.data.uid == request.auth.uid
          || resource.data.originalUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.originalUid == request.auth.uid
          || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.originalPostId is string
        && request.resource.data.originalUid is string
        && request.resource.data.originalUid != request.auth.uid
        && canViewUserContent(request.resource.data.originalUid)
        && repostId == request.resource.data.originalPostId + '_' + request.auth.uid
        && request.resource.data.originalText is string
        && request.resource.data.originalText.size() <= 2000
        && request.resource.data.keys().hasOnly(['uid','displayName','username','photoURL','originalPostId','originalUid','originalDisplayName','originalUsername','originalPhotoURL','originalText','originalBackground','originalCreatedAt','createdAt'])
        && (!('username' in request.resource.data) || request.resource.data.username is string)
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // PUBLIC FEED PROJECTION: contains repost cards, but not the private repost-list query.
    match /repostFeed/{repostId} {
      allow get, list: if signedIn() && canViewUserContent(resource.data.originalUid);
      allow create: if signedIn()
        && request.resource.data.originalPostId is string
        && request.resource.data.originalUid is string
        && request.resource.data.uid is string
        && canViewUserContent(request.resource.data.originalUid)
        && repostId == request.resource.data.originalPostId + '_' + request.resource.data.uid
        && (
          request.resource.data.uid == request.auth.uid
          || (
            request.resource.data.originalUid == request.auth.uid
            && exists(/databases/$(database)/documents/reposts/$(repostId))
            && get(/databases/$(database)/documents/reposts/$(repostId)).data.originalUid == request.auth.uid
            && get(/databases/$(database)/documents/reposts/$(repostId)).data.uid == request.resource.data.uid
          )
        )
        && request.resource.data.keys().hasOnly(['uid','displayName','username','photoURL','originalPostId','originalUid','originalDisplayName','originalUsername','originalPhotoURL','originalText','originalBackground','originalCreatedAt','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /stories/{storyId} {
      allow read: if canViewUserContent(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','displayName','text','lyrics','songTitle','songArtist','songUrl','previewUrl',
          'songArtwork','songStart','background','createdAt','expiresAt'
        ])
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.songTitle is string
        && request.resource.data.lyrics is string
        && request.resource.data.lyrics.size() <= 1200
        && (request.resource.data.text.size() > 0 || request.resource.data.songTitle.size() > 0)
        && request.resource.data.songArtist is string
        && request.resource.data.songUrl is string
        && request.resource.data.songUrl.size() <= 500
        && request.resource.data.previewUrl is string
        && request.resource.data.previewUrl.size() <= 1000
        && request.resource.data.songArtwork is string
        && request.resource.data.songArtwork.size() <= 500
        && request.resource.data.songStart is int
        && request.resource.data.songStart >= 0
        && request.resource.data.songStart <= 15
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text','lyrics','background','songTitle','songArtist','songUrl','previewUrl','songArtwork','songStart'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.songTitle is string
        && request.resource.data.lyrics is string
        && request.resource.data.lyrics.size() <= 1200
        && (request.resource.data.text.size() > 0 || request.resource.data.songTitle.size() > 0)
        && request.resource.data.background is string
        && request.resource.data.background.size() <= 200
        && request.resource.data.songTitle is string
        && request.resource.data.songArtist is string
        && request.resource.data.songUrl is string
        && request.resource.data.songUrl.size() <= 500
        && request.resource.data.previewUrl is string
        && request.resource.data.previewUrl.size() <= 1000
        && request.resource.data.songArtwork is string
        && request.resource.data.songArtwork.size() <= 500
        && request.resource.data.songStart is int
        && request.resource.data.songStart >= 0
        && request.resource.data.songStart <= 15;
    }

    // STORY HIGHLIGHTS: owner creates and manages saved story collections.
    match /storyHighlights/{highlightId} {
      allow read: if canViewUserContent(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 24
        && request.resource.data.stories is list
        && request.resource.data.stories.size() > 0
        && request.resource.data.stories.size() <= 20
        && request.resource.data.keys().hasOnly(['uid','title','coverText','coverStoryId','coverImage','stories','createdAt'])
        && request.resource.data.coverStoryId is string
        && request.resource.data.coverImage is string
        && request.resource.data.coverImage.size() <= 420000;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','coverText','coverStoryId','coverImage','stories'])
        && request.resource.data.coverStoryId is string
        && request.resource.data.coverImage is string
        && request.resource.data.coverImage.size() <= 420000
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 24
        && request.resource.data.stories is list
        && request.resource.data.stories.size() > 0
        && request.resource.data.stories.size() <= 20;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // STORY VIEWS: viewers can create their own view; only story owner can list viewers.
    match /storyViews/{viewId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyUid is string
        && canViewUserContent(request.resource.data.storyUid)
        && request.resource.data.storyUid != request.auth.uid
        && request.resource.data.storyId is string
        && viewId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['storyId','storyUid','uid','displayName','createdAt']);
      // A viewer can check their deterministic document ID even before it exists.
      // The story owner can read/list only views belonging to their own stories.
      allow get: if signedIn()
        && (viewId.matches('.*_' + request.auth.uid)
          || resource.data.storyUid == request.auth.uid);
      allow list: if signedIn()
        && resource.data.storyUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // STORY LIKES
    match /storyLikes/{likeId} {
      // A viewer can read their own like; only the story owner can list likes.
      allow get: if signedIn()
        && (likeId.matches('.*_' + request.auth.uid)
          || resource.data.storyUid == request.auth.uid);
      allow list: if signedIn()
        && resource.data.storyUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyId is string
        && request.resource.data.storyUid is string
        && canViewUserContent(request.resource.data.storyUid)
        && likeId == request.resource.data.storyId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['storyId','storyUid','uid','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // STORY REPLIES
    match /storyReplies/{replyId} {
      // Replies are private to the owner of the story they belong to.
      allow read: if signedIn()
        && resource.data.storyOwnerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storyId is string
        && request.resource.data.storyOwnerUid is string
        && canViewUserContent(request.resource.data.storyOwnerUid)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.keys().hasOnly(['storyId','storyOwnerUid','uid','displayName','text','createdAt']);
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.storyOwnerUid == request.auth.uid);
      allow update: if false;
    }

    // PUBLIC POST SAVE COUNTS: count saves without exposing private saved-post lists.
    match /postSaves/{saveId} {
      allow read: if signedIn() && canViewUserContent(resource.data.postUid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postUid is string
        && canViewUserContent(request.resource.data.postUid)
        && saveId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','postUid','uid','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // SAVED POSTS: each user manages only their own saved-post references.
    match /savedPosts/{savedId} {
      // Allow checking the deterministic own-save document, even before it exists.
      allow get: if signedIn()
        && (savedId.matches('.*_' + request.auth.uid)
          || resource.data.uid == request.auth.uid);

      // Queries must be constrained to the signed-in user's own saved posts.
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && savedId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','uid','createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // IN-APP NOTIFICATIONS: recipients can read their own; senders create their own activity.
    match /notifications/{notificationId} {
      allow get, list: if signedIn()
        && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 180
        && request.resource.data.type in ['post_like','post_comment','follow','follow_request','follow_accept','story_like','story_reply']
        && request.resource.data.postId is string
        && request.resource.data.storyId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['toUid','fromUid','fromName','type','message','postId','storyId','createdAt','read']);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn()
        && resource.data.toUid == request.auth.uid;
    }


    // ONLINE PRESENCE: signed-in users can see status; each user controls only their own status.
    match /userPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.keys().hasOnly(['uid','online','lastSeen']);
      allow delete: if false;
    }

    // DIRECT MESSAGES: only the two conversation participants can access a chat.
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participantUids;
      }

      allow get, list: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && noBlockWith(request.resource.data.participantUids[0] == request.auth.uid ? request.resource.data.participantUids[1] : request.resource.data.participantUids[0])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lastMessage == ''
        && request.resource.data.keys().hasOnly([
          'participantUids','createdBy','createdAt','updatedAt',
          'lastMessage','lastMessageAt','lastMessageSenderUid'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Participants cannot be changed after a conversation is created.
      // Only a participant sending a message may update the preview fields.
      allow update: if isParticipant()
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage','lastMessageAt','lastMessageSenderUid','updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageSenderUid == request.auth.uid
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in parentConversation().data.participantUids;
        }

        allow get, list: if isChatParticipant();

        allow create: if isChatParticipant()
          && noBlockWith(parentConversation().data.participantUids[0] == request.auth.uid ? parentConversation().data.participantUids[1] : parentConversation().data.participantUids[0])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in ['text','sticker','gif']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            'senderUid','text','type','createdAt','replyToId','replyToText','gifData','gifUrl','status'
          ])
          && (!('status' in request.resource.data) || request.resource.data.status == 'sent')
          && (!('replyToId' in request.resource.data) || request.resource.data.replyToId is string)
          && (!('replyToText' in request.resource.data) || request.resource.data.replyToText is string)
          && (request.resource.data.type != 'gif'
            || (('gifUrl' in request.resource.data
                && request.resource.data.gifUrl is string
                && request.resource.data.gifUrl.size() <= 2000
                && request.resource.data.gifUrl.matches('https://media[0-9]*\\.giphy\\.com/media/.*'))
              || ('gifData' in request.resource.data
                && request.resource.data.gifData is string
                && request.resource.data.gifData.size() <= 700000
                && request.resource.data.gifData.matches('data:image/gif;base64,.*'))));

        // A sender can edit only their own text; either participant can add/remove their own reaction.
        allow update: if isChatParticipant()
          && (
            (resource.data.senderUid == request.auth.uid
              && resource.data.type == 'text'
              && request.resource.data.senderUid == resource.data.senderUid
              && request.resource.data.type == resource.data.type
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && request.resource.data.editedAt is timestamp)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions is map
              && request.resource.data.reactions.keys().hasOnly(parentConversation().data.participantUids)
              && request.resource.data.reactions.values().hasOnly(['❤️','😂','😮','😢','🔥','👍','👏','😍']))
            ||
            (resource.data.senderUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','seenAt'])
              && request.resource.data.status == 'seen'
              && request.resource.data.seenAt is timestamp)
          );
        // Unsend removes the sender's message for both participants.
        // Either participant may clear the shared conversation history.
        allow delete: if isChatParticipant();
      }

      // Typing state is private to chat participants; each user controls only their own doc.
      match /typing/{uid} {
        function canUseTyping() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        }
        allow read: if canUseTyping();
        allow create, update: if canUseTyping()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.typing == true
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly(['uid','typing','updatedAt']);
        allow delete: if canUseTyping() && uid == request.auth.uid;
      }
    }

    // DENY ALL OTHER COLLECTIONS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}